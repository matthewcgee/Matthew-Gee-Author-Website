# Acuitas — build settings
#
# Copy this file to .env.production, fill in the values, then run
#   npm ci && npm run build
# Vite reads .env.production automatically for `npm run build`.
# .env.production is git-ignored: it never goes into the repository.
#
# Leave everything blank to build the self-contained demonstration copy
# (local mode: data stays in each browser, nothing is shared or sent).

# ── Where the app lives ─────────────────────────────────────────────
# URL path the app is served from. "/" for its own hostname
# (https://acuitas.example.org/), or "/acuitas/" for a sub-path.
ACUITAS_BASE=/
# Folder the build is written to. "dist" for a standalone repository.
ACUITAS_OUT_DIR=dist

# ── Shared database (service-line-wide use) ─────────────────────────
# The Firebase web-app config for your Firestore project, as one line of JSON.
# Firebase console → Project settings → Your apps → Web app → Config.
# These values identify the project; they are not a password. Access is
# enforced by firestore.rules plus sign-in, below.
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# ── Sign-in ─────────────────────────────────────────────────────────
# local    = no SSO; names are self-entered (demo / training only)
# firebase = SSO through Firebase Authentication — REQUIRED with the shared
#            database above, because firestore.rules check the signed-in user
# gateway  = SSO enforced by a proxy in front of the web server; local data only
# VITE_AUTH_MODE=firebase

# Firebase mode: the provider id you created under Authentication → Sign-in
# method, e.g. oidc.entra or saml.okta
# VITE_AUTH_PROVIDER_ID=oidc.entra

# Gateway mode only:
# VITE_IDENTITY_ENDPOINT=/.auth/me
# VITE_SIGN_IN_URL=/.auth/login/aad
# VITE_ROLE_MAP={"BH-House-Supervisors":"supervisor","BH-Charge-RNs":"charge"}
